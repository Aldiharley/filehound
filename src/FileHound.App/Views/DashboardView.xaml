<UserControl x:Class="FileHound.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:FileHound.App.Controls">
    <UserControl.Resources>
        <c:VisibleWhenConverter x:Key="VisibleWhen" />
        <Style x:Key="StatCard" TargetType="c:ClayCard" BasedOn="{StaticResource {x:Type c:ClayCard}}">
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="Padding" Value="20,18" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <!-- right margin leaves room for card shadows next to the scrollbar -->
        <StackPanel Margin="8,30,14,24">

            <!-- ================================================= hero -->
            <c:ClayCard Background="{StaticResource HeroGradient}" CornerRadius="28" Padding="0" Height="210">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="170" />
                    </Grid.ColumnDefinitions>
                    <Image Source="/Assets/hound-hero.png" Height="246" Margin="8,-40,0,-6" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                        <TextBlock Text="{Binding Greeting}" Style="{StaticResource HeroTitle}" Foreground="#5A3A2C" />
                        <TextBlock Text="Let's sniff out your files today." Style="{StaticResource Body}" FontSize="16" Foreground="#8A5A44" Margin="0,6,0,18" />
                        <Grid MaxWidth="520" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="HeroBox" Style="{StaticResource PillSearchBox}" MinWidth="300" Tag="Find a file or folder…"
                                     Text="{Binding HeroQuery, UpdateSourceTrigger=PropertyChanged}" KeyDown="HeroBox_KeyDown"
                                     AutomationProperties.Name="Search files and folders" />
                            <Button Grid.Column="1" Style="{StaticResource ClayButton}" Margin="12,0,0,0" Height="44"
                                    Command="{Binding SearchCommand}" CommandParameter="{Binding HeroQuery}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource SymbolFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="Sniff it out" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                    <Image Grid.Column="2" Source="/Assets/icon-star.png" Width="96" Height="96" Margin="0,0,30,24" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" Opacity="0.95" />
                </Grid>
            </c:ClayCard>

            <!-- ================================================= stat cards -->
            <Grid Margin="0,22,-16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                </Grid.ColumnDefinitions>
                <c:ClayCard Style="{StaticResource StatCard}" Background="{StaticResource Mint}">
                    <StackPanel>
                        <Border Style="{StaticResource IconTile}" HorizontalAlignment="Left"><Image Source="/Assets/icon-document.png" /></Border>
                        <TextBlock Text="Files indexed" Style="{StaticResource BodyStrong}" Margin="0,14,0,2" />
                        <TextBlock Text="{Binding FilesText}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="{Binding FilesCaption}" Style="{StaticResource Caption}" Foreground="#4E7F5E" FontWeight="SemiBold" />
                    </StackPanel>
                </c:ClayCard>
                <c:ClayCard Grid.Column="1" Style="{StaticResource StatCard}" Background="{StaticResource Peach}">
                    <StackPanel>
                        <Border Style="{StaticResource IconTile}" HorizontalAlignment="Left"><Image Source="/Assets/icon-folder.png" /></Border>
                        <TextBlock Text="Folders" Style="{StaticResource BodyStrong}" Margin="0,14,0,2" />
                        <TextBlock Text="{Binding FoldersText}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="{Binding FoldersCaption}" Style="{StaticResource Caption}" Foreground="#A35B3E" FontWeight="SemiBold" />
                    </StackPanel>
                </c:ClayCard>
                <c:ClayCard Grid.Column="2" Style="{StaticResource StatCard}" Background="{StaticResource Butter}">
                    <StackPanel>
                        <Border Style="{StaticResource IconTile}" HorizontalAlignment="Left"><Image Source="/Assets/icon-drive.png" /></Border>
                        <TextBlock Text="Drives" Style="{StaticResource BodyStrong}" Margin="0,14,0,2" />
                        <TextBlock Text="{Binding DrivesText}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="{Binding DrivesCaption}" Style="{StaticResource Caption}" Foreground="#8C6A1E" FontWeight="SemiBold" />
                    </StackPanel>
                </c:ClayCard>
                <c:ClayCard Grid.Column="3" Style="{StaticResource StatCard}" Background="{StaticResource Sky}">
                    <StackPanel>
                        <Border Style="{StaticResource IconTile}" HorizontalAlignment="Left"><Image Source="/Assets/icon-bolt.png" /></Border>
                        <TextBlock Text="Index mode" Style="{StaticResource BodyStrong}" Margin="0,14,0,2" />
                        <TextBlock Text="{Binding IndexModeText}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="{Binding IndexCaption}" Style="{StaticResource Caption}" Foreground="#4F6A93" FontWeight="SemiBold" />
                    </StackPanel>
                </c:ClayCard>
            </Grid>

            <!-- ================================================= drives + file types -->
            <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <c:ClayCard>
                    <StackPanel>
                        <TextBlock Text="Your drives" Style="{StaticResource Title}" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding Drives}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="/Assets/icon-drive.png" Width="36" Height="36" HorizontalAlignment="Left" />
                                        <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding EntriesText}" Style="{StaticResource Number}" />
                                                <TextBlock>
                                                    <Run Text="{Binding Title, Mode=OneWay}" FontWeight="Bold" />
                                                    <Run Text="{Binding Label, Mode=OneWay}" Foreground="{StaticResource InkSoft}" />
                                                </TextBlock>
                                            </DockPanel>
                                            <ProgressBar Style="{StaticResource ClayProgress}" Maximum="1" Value="{Binding UsedFraction, Mode=OneWay}" Foreground="{Binding UsedBrush}" Margin="0,6,0,4" Height="8"
                                                         Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                                            <ProgressBar Style="{StaticResource ClayProgress}" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Foreground="{StaticResource ButterDeep}" Margin="0,6,0,4" Height="8"
                                                         Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}" />
                                            <TextBlock Style="{StaticResource Caption}">
                                                <Run Text="{Binding CapacityText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding StatusText, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <Border Grid.Column="2" CornerRadius="11" Padding="10,3" Background="{Binding ModeBrush}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ModeText}" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </c:ClayCard>

                <c:ClayCard Grid.Column="2">
                    <StackPanel>
                        <TextBlock Text="File types" Style="{StaticResource Title}" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <c:DonutChart Slices="{Binding Slices}" Width="160" Height="160" Thickness="34" HorizontalAlignment="Left" VerticalAlignment="Top" />
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Slices}" VerticalAlignment="Center" Margin="10,0,0,0" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="11" Height="11" Fill="{Binding Brush}" HorizontalAlignment="Left" />
                                            <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="13" ToolTip="{Binding CountText}" />
                                            <TextBlock Grid.Column="2" Text="{Binding PercentText}" Style="{StaticResource Number}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </StackPanel>
                </c:ClayCard>
            </Grid>

            <!-- ================================================= recent + largest -->
            <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <c:ClayCard>
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Clear" Command="{Binding ClearRecentCommand}"
                                    Visibility="{Binding HasRecent, Converter={StaticResource VisibleWhen}}" />
                            <TextBlock Text="Recent searches" Style="{StaticResource Title}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding RecentSearches}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SearchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bg" CornerRadius="12" Padding="8,6" Background="Transparent">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="40" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Image Source="/Assets/icon-clock.png" Width="28" Height="28" HorizontalAlignment="Left" />
                                                        <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource BodyStrong}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        <Border Grid.Column="2" Width="30" Height="30" CornerRadius="15" Background="{StaticResource Surface}" Effect="{StaticResource ClayShadowSmall}">
                                                            <TextBlock Text="&#xE72A;" FontFamily="{StaticResource SymbolFont}" FontSize="11" Foreground="{StaticResource SkyDeep}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="{StaticResource SurfaceSunken}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Visibility="{Binding HasRecent, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" Margin="0,8">
                            <TextBlock Text="Your searches will show up here." Style="{StaticResource Caption}" FontSize="13" />
                        </StackPanel>
                    </StackPanel>
                </c:ClayCard>

                <c:ClayCard Grid.Column="2">
                    <StackPanel>
                        <TextBlock Text="Largest files" Style="{StaticResource Title}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Largest}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{Binding Icon}" Width="26" Height="26" HorizontalAlignment="Left" />
                                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrong}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding FolderPath}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource Number}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <Button Grid.Column="3" Style="{StaticResource RoundButton}" Width="32" Height="32" Content="&#xED25;" ToolTip="Show in folder"
                                                Command="{Binding DataContext.RevealFileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsMeasuring, Converter={StaticResource VisibleWhen}}" Margin="0,6,0,0">
                            <Image Source="/Assets/hound-sniff.png" Width="54" Height="54" />
                            <TextBlock Text="Measuring files… sizes keep filling in" Style="{StaticResource Caption}" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </c:ClayCard>
            </Grid>

            <!-- ================================================= tip banner -->
            <c:ClayCard Margin="0,22,0,6" Background="{StaticResource Mint}" Padding="18,12" CornerRadius="24">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource MintButton}" Content="Try it" Command="{Binding SearchCommand}" CommandParameter="" />
                    <Image Source="/Assets/icon-paw.png" Width="46" Height="46" Margin="0,0,14,0" />
                    <TextBlock VerticalAlignment="Center" FontSize="15" Foreground="#2F5A3E">
                        <Run Text="Press" /> <Run Text="{Binding HotkeyText, Mode=OneWay}" FontWeight="Bold" /> <Run Text="anywhere to summon FileHound ✨" />
                    </TextBlock>
                </DockPanel>
            </c:ClayCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
