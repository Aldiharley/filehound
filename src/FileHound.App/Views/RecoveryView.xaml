<UserControl x:Class="FileHound.App.Views.RecoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:FileHound.App.Controls"
             xmlns:rvm="clr-namespace:FileHound.App.ViewModels.Recovery">
    <UserControl.Resources>
        <c:VisibleWhenConverter x:Key="VisibleWhen" />
        <c:EnumEqualsConverter x:Key="EnumEquals" />
        <c:InvertBoolConverter x:Key="Invert" />

        <!-- Drive pills in the drive strip -->
        <Style x:Key="DrivePill" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ClayFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Margin="0,0,8,0">
                            <Border x:Name="Base" CornerRadius="17" Height="34" Background="{StaticResource Surface}" BorderThickness="1" BorderBrush="{StaticResource SurfaceSunken}" />
                            <Border x:Name="Fill" CornerRadius="17" Background="{StaticResource Peach}" Opacity="0" Effect="{StaticResource ClayShadowSmall}" />
                            <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{StaticResource InkSoft}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Base" Property="Background" Value="{StaticResource SurfaceSunken}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Fill" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clay check box for row selection -->
        <Style x:Key="RowCheck" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ClayFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="22" Height="22" Background="Transparent">
                            <Border x:Name="Box" CornerRadius="7" Background="{StaticResource SurfaceSunken}" BorderThickness="1" BorderBrush="{StaticResource InkFaint}" />
                            <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="{StaticResource SymbolFont}" FontSize="12" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource MintDeep}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource MintDeep}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource PeachDeep}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RecoveryRow" TargetType="ListBoxItem" BasedOn="{StaticResource ResultItem}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
        </Style>

        <!-- One candidate row; shared by both tabs -->
        <DataTemplate x:Key="CandidateRow" DataType="{x:Type rvm:RecoveryItem}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Style="{StaticResource RowCheck}" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" HorizontalAlignment="Left"
                          AutomationProperties.Name="{Binding Name, StringFormat=Select {0}}" />
                <Image Grid.Column="1" Source="{Binding Icon, IsAsync=False}" Width="24" Height="24" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrong}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Folder}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" ToolTip="{Binding Detail}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUnknownFolder}" Value="True">
                                        <Setter Property="FontStyle" Value="Italic" />
                                        <Setter Property="Foreground" Value="{StaticResource InkFaint}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <TextBlock Grid.Column="3" Text="{Binding SizeText}" Style="{StaticResource Number}" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="{Binding WhenText}" Style="{StaticResource Number}" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="{Binding WhenTooltip}" />
                <Border Grid.Column="5" Style="{StaticResource GradeChip}" Tag="{Binding GradeKey}" HorizontalAlignment="Right" Margin="12,0,0,0" ToolTip="{Binding GradeTooltip}">
                    <TextBlock Text="{Binding GradeText}" />
                </Border>
                <StackPanel Grid.Column="6" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding Status, Converter={StaticResource VisibleWhen}}">
                    <Border Style="{StaticResource GradeChip}" Tag="{Binding StatusKey}" ToolTip="{Binding RecoveredPath}">
                        <TextBlock Text="{Binding Status}" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                    </Border>
                    <TextBlock Text="{Binding Sha256Short}" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="{StaticResource InkFaint}" Margin="8,0,0,0" VerticalAlignment="Center"
                               ToolTip="{Binding Sha256}" Visibility="{Binding Sha256, Converter={StaticResource VisibleWhen}}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- One carved file (Deep scan rows) -->
        <DataTemplate x:Key="CarvedRow" DataType="{x:Type rvm:RecoveryItem}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Style="{StaticResource RowCheck}" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" HorizontalAlignment="Left"
                          AutomationProperties.Name="{Binding Name, StringFormat=Select {0}}" />
                <Grid Grid.Column="1" Width="40" Height="40" HorizontalAlignment="Left">
                    <Border CornerRadius="10" Background="{Binding TypeBrush}" />
                    <Image Source="{Binding Thumbnail, IsAsync=True}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Clip><RectangleGeometry Rect="0,0,40,40" RadiusX="10" RadiusY="10" /></Image.Clip>
                    </Image>
                </Grid>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding TypeLabel}" Style="{StaticResource BodyStrong}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" ToolTip="{Binding Detail}" />
                </StackPanel>
                <TextBlock Grid.Column="3" Text="{Binding SizeText}" Style="{StaticResource Number}" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="{Binding LocationText}" Style="{StaticResource Number}" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center" />
                <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding Status, Converter={StaticResource VisibleWhen}}">
                    <Border Style="{StaticResource GradeChip}" Tag="{Binding StatusKey}" ToolTip="{Binding RecoveredPath}">
                        <TextBlock Text="{Binding Status}" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Column header shared by both tabs -->
        <DataTemplate x:Key="ColumnHeader">
            <Grid Margin="12,4,22,6" TextElement.Foreground="{StaticResource InkFaint}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="190" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="2" Text="NAME" FontSize="11" FontWeight="SemiBold" />
                <TextBlock Grid.Column="3" Text="SIZE" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="4" Text="DELETED" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="5" Text="CHANCES" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="VersionHeader">
            <Grid Margin="12,4,22,6" TextElement.Foreground="{StaticResource InkFaint}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="190" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="2" Text="NAME" FontSize="11" FontWeight="SemiBold" />
                <TextBlock Grid.Column="3" Text="SIZE" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="4" Text="SNAPSHOT" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="5" Text="CHANCES" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="8,4,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================================================= drive & source strip -->
        <c:ClayCard Background="{StaticResource Sky}" CornerRadius="24" Padding="18,14" Margin="0,0,0,14">
            <StackPanel>
                <DockPanel>
                    <Border DockPanel.Dock="Right" CornerRadius="17" Height="34" Background="{StaticResource Mint}" Padding="10,0,14,0" VerticalAlignment="Center"
                            ToolTip="FileHound only reads this drive during recovery. Its own index and logs are paused for it.">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="/Assets/icon-shield.png" Width="22" Height="22" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="Read-only" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource GradeMintInk}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Image Source="/Assets/icon-drive.png" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Drive" Style="{StaticResource BodyStrong}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ListBox ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Padding="0"
                             ItemContainerStyle="{StaticResource DrivePill}" VerticalAlignment="Center" AutomationProperties.Name="Drive to recover from"
                             IsEnabled="{Binding IsBusy, Converter={StaticResource Invert}}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </DockPanel>

                <WrapPanel Margin="0,14,0,0">
                    <RadioButton Style="{StaticResource Chip}" GroupName="rtab" Background="{StaticResource Mint}"
                                 IsChecked="{Binding CurrentTab, Converter={StaticResource EnumEquals}, ConverterParameter=RecycleBin}" AutomationProperties.Name="Recycle Bin tab">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/icon-recycle.png" Width="20" Height="20" Margin="0,0,7,0" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="Recycle Bin" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding RecycleBin.Count}" Margin="7,0,0,0" FontSize="12" Foreground="{StaticResource InkSoft}" VerticalAlignment="Center"
                                       Visibility="{Binding RecycleBin.Count, Converter={StaticResource VisibleWhen}}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Chip}" GroupName="rtab" Background="{StaticResource Butter}"
                                 IsChecked="{Binding CurrentTab, Converter={StaticResource EnumEquals}, ConverterParameter=Deleted}" AutomationProperties.Name="Recently deleted tab">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/icon-timeline.png" Width="20" Height="20" Margin="0,0,7,0" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="Recently deleted" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Deleted.Count}" Margin="7,0,0,0" FontSize="12" Foreground="{StaticResource InkSoft}" VerticalAlignment="Center"
                                       Visibility="{Binding Deleted.Count, Converter={StaticResource VisibleWhen}}" />
                            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource SymbolFont}" FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource InkFaint}"
                                       ToolTip="Needs administrator access (Turbo)" Visibility="{Binding IsElevated, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Chip}" GroupName="rtab" Background="{StaticResource Lilac}"
                                 IsChecked="{Binding CurrentTab, Converter={StaticResource EnumEquals}, ConverterParameter=PreviousVersions}" AutomationProperties.Name="Previous versions tab">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/icon-shadow.png" Width="20" Height="20" Margin="0,0,7,0" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="Previous versions" VerticalAlignment="Center" />
                            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource SymbolFont}" FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource InkFaint}"
                                       ToolTip="Needs administrator access (Turbo)" Visibility="{Binding IsElevated, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Chip}" GroupName="rtab" Background="{StaticResource Sky}"
                                 IsChecked="{Binding CurrentTab, Converter={StaticResource EnumEquals}, ConverterParameter=Undelete}" AutomationProperties.Name="Undelete tab">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/icon-undelete.png" Width="20" Height="20" Margin="0,0,7,0" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="Undelete" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Undelete.Count}" Margin="7,0,0,0" FontSize="12" Foreground="{StaticResource InkSoft}" VerticalAlignment="Center"
                                       Visibility="{Binding Undelete.Count, Converter={StaticResource VisibleWhen}}" />
                            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource SymbolFont}" FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource InkFaint}"
                                       ToolTip="Needs administrator access (Turbo)" Visibility="{Binding IsElevated, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Chip}" GroupName="rtab" Background="{StaticResource Peach}"
                                 IsChecked="{Binding CurrentTab, Converter={StaticResource EnumEquals}, ConverterParameter=DeepScan}" AutomationProperties.Name="Deep scan tab">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/icon-scan.png" Width="20" Height="20" Margin="0,0,7,0" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="Deep scan" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DeepScan.Count}" Margin="7,0,0,0" FontSize="12" Foreground="{StaticResource InkSoft}" VerticalAlignment="Center"
                                       Visibility="{Binding DeepScan.Count, Converter={StaticResource VisibleWhen}}" />
                            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource SymbolFont}" FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource InkFaint}"
                                       ToolTip="Needs administrator access (Turbo)" Visibility="{Binding IsElevated, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                        </StackPanel>
                    </RadioButton>
                </WrapPanel>
            </StackPanel>
        </c:ClayCard>

        <!-- ================================================= tab content -->
        <c:ClayCard Grid.Row="1" Padding="10,8,10,8" CornerRadius="24">
            <Grid>
                <!-- Recycle Bin tab -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="RecycleBin"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="4,4,4,8" DataContext="{Binding RecycleBin}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <CheckBox Style="{StaticResource ClaySwitch}" IsChecked="{Binding ShowAllUsers}" Content="All users" FontSize="13" Margin="0,0,14,0"
                                      Visibility="{Binding DataContext.IsElevated, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource VisibleWhen}}"
                                      ToolTip="Show other accounts' Recycle Bins on this drive" />
                            <Button Style="{StaticResource SoftButton}" Command="{Binding DataContext.ExportCsvCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" ToolTip="Export this list as CSV">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Assets/icon-export.png" Width="20" Height="20" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock Text="Export CSV" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Grid Width="300" HorizontalAlignment="Left">
                            <TextBox Style="{StaticResource ClayTextBox}" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewKeyDown="Filter_PreviewKeyDown" AutomationProperties.Name="Filter Recycle Bin items" />
                            <TextBlock Text="Filter by name or folder" Foreground="{StaticResource InkFaint}" FontSize="13" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="{Binding Filter, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                        </Grid>
                    </DockPanel>
                    <ContentControl Grid.Row="1" ContentTemplate="{StaticResource ColumnHeader}" Content="{Binding}" Focusable="False" />
                    <ListBox Grid.Row="2" ItemsSource="{Binding RecycleBin.Items}" ItemTemplate="{StaticResource CandidateRow}" ItemContainerStyle="{StaticResource RecoveryRow}"
                             Background="Transparent" BorderThickness="0" SelectionMode="Extended"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                             PreviewKeyDown="List_PreviewKeyDown" AutomationProperties.Name="Recycle Bin items">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Copy original path" Command="{Binding RecycleBin.CopyOriginalPathCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Icon="&#xE8C8;" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                    <StackPanel Grid.Row="1" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding RecycleBin.IsEmpty, Converter={StaticResource VisibleWhen}}">
                        <Image Source="/Assets/hound-dig.png" Width="200" Height="200" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="Your Recycle Bin is empty here" Style="{StaticResource HeroTitle}" FontSize="22" HorizontalAlignment="Center" Margin="0,4,0,6" />
                        <TextBlock Text="Try Recently deleted for files that skipped the bin." Style="{StaticResource Caption}" FontSize="13" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Recently deleted tab -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="Deleted"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- no deletion log: needs Turbo, or the drive is still being indexed -->
                    <c:ClayCard CornerRadius="20" Padding="18,14" Margin="2,2,2,8"
                                Visibility="{Binding Deleted.IsAvailable, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                        <c:ClayCard.Style>
                            <Style TargetType="c:ClayCard">
                                <Setter Property="Background" Value="{StaticResource Butter}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Deleted.NeedsTurbo}" Value="True"><Setter Property="Background" Value="{StaticResource Peach}" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </c:ClayCard.Style>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource ClayButton}" Content="Enable Turbo" Command="{Binding EnableTurboCommand}" VerticalAlignment="Center"
                                    Visibility="{Binding Deleted.NeedsTurbo, Converter={StaticResource VisibleWhen}}" />
                            <Image Width="48" Height="48" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Source" Value="/Assets/hound-sniff.png" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Deleted.NeedsTurbo}" Value="True"><Setter Property="Source" Value="/Assets/icon-bolt.png" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Deleted.UnavailableTitle}" Style="{StaticResource Title}" />
                                <TextBlock Text="{Binding Deleted.UnavailableText}" Style="{StaticResource Body}" Foreground="#7A4A36" TextWrapping="Wrap" Margin="0,4,16,0" />
                            </StackPanel>
                        </DockPanel>
                    </c:ClayCard>

                    <!-- journal banner -->
                    <Border Grid.Row="1" CornerRadius="12" Background="{StaticResource Butter}" Padding="12,6" Margin="2,2,2,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Deleted.IsAvailable}" Value="True" />
                                            <Condition Binding="{Binding JournalBannerDismissed}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource RoundButton}" Width="28" Height="28" Content="&#xE711;" FontSize="11" Command="{Binding DismissJournalBannerCommand}"
                                    ToolTip="Dismiss" AutomationProperties.Name="Dismiss" />
                            <Image Source="/Assets/icon-paw.png" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap">
                                <Run Text="FileHound keeps a log of deletions from the drive's change journal. The journal covers roughly" />
                                <Run Text="{Binding Deleted.JournalSpanText, Mode=OneWay}" /><Run Text=" of activity." />
                            </TextBlock>
                        </DockPanel>
                    </Border>

                    <DockPanel Grid.Row="2" Margin="4,4,4,8" DataContext="{Binding Deleted}" Visibility="{Binding IsAvailable, Converter={StaticResource VisibleWhen}}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Chip}" GroupName="dsort" Height="30" FontSize="12" Content="Newest" Background="{StaticResource Butter}"
                                         IsChecked="{Binding Sort, Converter={StaticResource EnumEquals}, ConverterParameter=Newest}" />
                            <RadioButton Style="{StaticResource Chip}" GroupName="dsort" Height="30" FontSize="12" Content="Name" Background="{StaticResource Sky}"
                                         IsChecked="{Binding Sort, Converter={StaticResource EnumEquals}, ConverterParameter=Name}" />
                            <RadioButton Style="{StaticResource Chip}" GroupName="dsort" Height="30" FontSize="12" Content="Size" Background="{StaticResource Lilac}" Margin="0,0,14,0"
                                         IsChecked="{Binding Sort, Converter={StaticResource EnumEquals}, ConverterParameter=Size}" />
                            <Button Style="{StaticResource SoftButton}" Command="{Binding DataContext.ExportCsvCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" ToolTip="Export the deletion log as CSV" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Assets/icon-export.png" Width="20" Height="20" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock Text="CSV" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SoftButton}" Content="DFXML" Command="{Binding DataContext.ExportDfxmlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    ToolTip="Export this recovery session as Digital Forensics XML" />
                        </StackPanel>
                        <Grid Width="300" HorizontalAlignment="Left">
                            <TextBox Style="{StaticResource ClayTextBox}" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewKeyDown="Filter_PreviewKeyDown" AutomationProperties.Name="Filter deleted files" />
                            <TextBlock Text="Filter by name or folder" Foreground="{StaticResource InkFaint}" FontSize="13" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="{Binding Filter, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                        </Grid>
                        <CheckBox Style="{StaticResource ClaySwitch}" IsChecked="{Binding HideNoise}" Content="Hide noise" FontSize="13" Margin="16,0,0,0" HorizontalAlignment="Left"
                                  ToolTip="Hides temp files, caches, lock files and files that were immediately replaced by a new version" />
                    </DockPanel>

                    <Grid Grid.Row="3" Visibility="{Binding Deleted.IsAvailable, Converter={StaticResource VisibleWhen}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ContentControl ContentTemplate="{StaticResource ColumnHeader}" Content="{Binding}" Focusable="False" />
                        <ListBox Grid.Row="1" ItemsSource="{Binding Deleted.Items}" ItemTemplate="{StaticResource CandidateRow}" ItemContainerStyle="{StaticResource RecoveryRow}"
                                 Background="Transparent" BorderThickness="0" SelectionMode="Extended"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                                 PreviewKeyDown="List_PreviewKeyDown" AutomationProperties.Name="Recently deleted files">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Copy original path" Command="{Binding Deleted.CopyOriginalPathCommand}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Icon="&#xE8C8;" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                        <StackPanel Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding Deleted.IsEmpty, Converter={StaticResource VisibleWhen}}">
                            <Image Source="/Assets/hound-dig.png" Width="200" Height="200" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="No deletions in the journal yet" Style="{StaticResource HeroTitle}" FontSize="22" HorizontalAlignment="Center" Margin="0,4,0,6" />
                            <TextBlock Text="The log fills as files are deleted while FileHound is running, or from the journal's history." Style="{StaticResource Caption}" FontSize="13" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Undelete tab -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="Undelete"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <c:ClayCard Background="{StaticResource Peach}" CornerRadius="20" Padding="18,14" Margin="2,2,2,8"
                                Visibility="{Binding Undelete.IsAvailable, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource ClayButton}" Content="Enable Turbo" Command="{Binding EnableTurboCommand}" VerticalAlignment="Center"
                                    Visibility="{Binding IsElevated, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                            <Image Source="/Assets/icon-bolt.png" Width="48" Height="48" Margin="0,0,14,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Needs administrator access" Style="{StaticResource Title}" />
                                <TextBlock Style="{StaticResource Body}" Foreground="#7A4A36" TextWrapping="Wrap" Margin="0,4,16,0"
                                           Text="Undelete reads the drive's master file table directly to find records of deleted files. Enable Turbo (one administrator approval) to scan." />
                            </StackPanel>
                        </DockPanel>
                    </c:ClayCard>

                    <DockPanel Grid.Row="1" Margin="4,4,4,8" Visibility="{Binding Undelete.IsAvailable, Converter={StaticResource VisibleWhen}}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" DataContext="{Binding Undelete}">
                            <RadioButton Style="{StaticResource Chip}" GroupName="usort" Height="30" FontSize="12" Content="Best grade" Background="{StaticResource Mint}"
                                         IsChecked="{Binding Sort, Converter={StaticResource EnumEquals}, ConverterParameter=BestGrade}" />
                            <RadioButton Style="{StaticResource Chip}" GroupName="usort" Height="30" FontSize="12" Content="Newest" Background="{StaticResource Butter}"
                                         IsChecked="{Binding Sort, Converter={StaticResource EnumEquals}, ConverterParameter=Newest}" />
                            <RadioButton Style="{StaticResource Chip}" GroupName="usort" Height="30" FontSize="12" Content="Name" Background="{StaticResource Sky}"
                                         IsChecked="{Binding Sort, Converter={StaticResource EnumEquals}, ConverterParameter=Name}" />
                            <RadioButton Style="{StaticResource Chip}" GroupName="usort" Height="30" FontSize="12" Content="Size" Background="{StaticResource Lilac}" Margin="0,0,14,0"
                                         IsChecked="{Binding Sort, Converter={StaticResource EnumEquals}, ConverterParameter=Size}" />
                            <Button Style="{StaticResource SoftButton}" Command="{Binding DataContext.ExportCsvCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" ToolTip="Export this list as CSV" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Assets/icon-export.png" Width="20" Height="20" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock Text="CSV" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SoftButton}" Content="DFXML" Command="{Binding DataContext.ExportDfxmlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    ToolTip="Export this recovery session as Digital Forensics XML" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" DataContext="{Binding Undelete}">
                            <Button Style="{StaticResource ClayButton}" Command="{Binding ScanCommand}" MinWidth="110" AutomationProperties.Name="{Binding ScanButtonText}">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Assets/hound-sniff.png" Width="24" Height="24" Margin="-4,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding IsScanning, Converter={StaticResource VisibleWhen}}" />
                                    <TextBlock VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding ScanButtonText}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsScanning}" Value="True"><Setter Property="Text" Value="Scanning…" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SoftButton}" Content="Stop" Command="{Binding ScanCancelCommand}" Margin="8,0,0,0"
                                    Visibility="{Binding IsScanning, Converter={StaticResource VisibleWhen}}" />
                            <Grid Width="260" Margin="14,0,0,0" Visibility="{Binding HasScanned, Converter={StaticResource VisibleWhen}}">
                                <TextBox Style="{StaticResource ClayTextBox}" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                                         PreviewKeyDown="Filter_PreviewKeyDown" AutomationProperties.Name="Filter deleted files" />
                                <TextBlock Text="Filter by name or folder" Foreground="{StaticResource InkFaint}" FontSize="13" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                           Visibility="{Binding Filter, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                            </Grid>
                            <TextBlock Text="{Binding ReadPathText}" Style="{StaticResource Caption}" FontSize="12" Margin="14,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding ReadPathText, Converter={StaticResource VisibleWhen}}" />
                        </StackPanel>
                    </DockPanel>

                    <!-- progress / error / why -->
                    <StackPanel Grid.Row="2" Margin="4,0,4,6" DataContext="{Binding Undelete}" Visibility="{Binding IsAvailable, Converter={StaticResource VisibleWhen}}">
                        <DockPanel Margin="0,0,0,8" Visibility="{Binding IsScanning, Converter={StaticResource VisibleWhen}}">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" Style="{StaticResource Caption}" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" />
                            <ProgressBar Style="{StaticResource ClayProgress}" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Foreground="{StaticResource SkyDeep}" Height="8" VerticalAlignment="Center"
                                         AutomationProperties.Name="{Binding ProgressText}" />
                        </DockPanel>
                        <Border CornerRadius="12" Background="{StaticResource Rose}" Padding="12,8" Margin="0,0,0,8" Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Text="{Binding Error}" Foreground="{StaticResource GradeRoseInk}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </Border>
                        <ToggleButton Style="{StaticResource ToggleChip}" IsChecked="{Binding WhyExpanded}" HorizontalAlignment="Left" Height="28" FontSize="12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Why some files can't come back" VerticalAlignment="Center" />
                                <TextBlock Text="&#xE70D;" FontFamily="{StaticResource SymbolFont}" FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <Border CornerRadius="14" Background="{StaticResource SurfaceSunken}" Padding="14,10" Margin="0,8,0,0" Visibility="{Binding WhyExpanded, Converter={StaticResource VisibleWhen}}">
                            <StackPanel TextElement.FontSize="12">
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"><Run FontWeight="SemiBold" Text="Zeroed — " /><Run Text="On SSDs, Windows tells the drive to discard deleted data within seconds. If a file shows Zeroed, no copy of it exists on this drive." /></TextBlock>
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"><Run FontWeight="SemiBold" Text="Record reused — " /><Run Text="Another file has taken the deleted file's record, so its name and location are gone; Deep scan (coming) can still find its contents by signature." /></TextBlock>
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"><Run FontWeight="SemiBold" Text="Overwritten — " /><Run Text="Other files have been written over the space the deleted file used. Partially overwritten files come back with gaps." /></TextBlock>
                                <TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="Encrypted — " /><Run Text="Files encrypted with EFS can't be decrypted outside the account that encrypted them." /></TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <ContentControl Grid.Row="3" ContentTemplate="{StaticResource ColumnHeader}" Content="{Binding}" Focusable="False"
                                    Visibility="{Binding Undelete.HasScanned, Converter={StaticResource VisibleWhen}}" />
                    <ListBox Grid.Row="4" ItemsSource="{Binding Undelete.Items}" ItemTemplate="{StaticResource CandidateRow}" ItemContainerStyle="{StaticResource RecoveryRow}"
                             Background="Transparent" BorderThickness="0" SelectionMode="Extended"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                             PreviewKeyDown="List_PreviewKeyDown" AutomationProperties.Name="Deleted files found by undelete">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Copy original path" Command="{Binding Undelete.CopyOriginalPathCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Icon="&#xE8C8;" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                    <StackPanel Grid.Row="3" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Undelete.IsAvailable}" Value="True" />
                                            <Condition Binding="{Binding Undelete.HasScanned}" Value="False" />
                                            <Condition Binding="{Binding Undelete.IsScanning}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Image Source="/Assets/hound-dig.png" Width="200" Height="200" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="Ready to dig" Style="{StaticResource HeroTitle}" FontSize="22" HorizontalAlignment="Center" Margin="0,4,0,6" />
                        <TextBlock Text="Scan reads the drive's master file table for records of deleted files. It takes a few seconds per million files." Style="{StaticResource Caption}" FontSize="13" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding Undelete.IsEmpty, Converter={StaticResource VisibleWhen}}">
                        <Image Source="/Assets/hound-shrug.png" Width="200" Height="200" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="No deleted records on this drive" Style="{StaticResource HeroTitle}" FontSize="22" HorizontalAlignment="Center" Margin="0,4,0,6" />
                        <TextBlock Text="Every record in the master file table is in use. Try Previous versions if the drive has snapshots." Style="{StaticResource Caption}" FontSize="13" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Previous versions tab -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="PreviousVersions"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <c:ClayCard Background="{StaticResource Peach}" CornerRadius="20" Padding="18,14" Margin="2,2,2,8"
                                Visibility="{Binding Versions.IsAvailable, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource ClayButton}" Content="Enable Turbo" Command="{Binding EnableTurboCommand}" VerticalAlignment="Center"
                                    Visibility="{Binding IsElevated, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                            <Image Source="/Assets/icon-bolt.png" Width="48" Height="48" Margin="0,0,14,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Needs administrator access" Style="{StaticResource Title}" />
                                <TextBlock Style="{StaticResource Body}" Foreground="#7A4A36" TextWrapping="Wrap" Margin="0,4,16,0"
                                           Text="Previous versions come from Windows' shadow copies (restore points), which only an administrator can read. Enable Turbo to look." />
                            </StackPanel>
                        </DockPanel>
                    </c:ClayCard>

                    <DockPanel Grid.Row="1" Margin="4,4,4,8" DataContext="{Binding Versions}" Visibility="{Binding IsAvailable, Converter={StaticResource VisibleWhen}}">
                        <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Command="{Binding FreezeCommand}" Margin="14,0,0,0"
                                ToolTip="Creates a snapshot of this drive now (writes a small amount of data to it)">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Assets/icon-shadow.png" Width="20" Height="20" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="Freeze this drive now" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource ClayButton}" Content="Look up" Command="{Binding LookupCommand}" Margin="10,0,0,0" MinWidth="100" />
                        <Grid>
                            <TextBox Style="{StaticResource ClayTextBox}" Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="VersionsPath_PreviewKeyDown"
                                     AutomationProperties.Name="Path to look up in snapshots" />
                            <TextBlock Text="Type or paste a file or folder path on this drive…" Foreground="{StaticResource InkFaint}" FontSize="13" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="{Binding Path, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                        </Grid>
                    </DockPanel>
                    <StackPanel Grid.Row="2" Margin="6,0,4,8" DataContext="{Binding Versions}" Visibility="{Binding IsAvailable, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Text="{Binding SnapshotsText}" Style="{StaticResource Caption}" FontSize="12" />
                        <Border CornerRadius="12" Background="{StaticResource Rose}" Padding="12,8" Margin="0,8,0,0" Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Text="{Binding Error}" Foreground="{StaticResource GradeRoseInk}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>

                    <ContentControl Grid.Row="3" ContentTemplate="{StaticResource VersionHeader}" Content="{Binding}" Focusable="False"
                                    Visibility="{Binding Versions.Count, Converter={StaticResource VisibleWhen}}" />
                    <ListBox Grid.Row="4" ItemsSource="{Binding Versions.Items}" ItemTemplate="{StaticResource CandidateRow}" ItemContainerStyle="{StaticResource RecoveryRow}"
                             Background="Transparent" BorderThickness="0" SelectionMode="Extended"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                             PreviewKeyDown="List_PreviewKeyDown" AutomationProperties.Name="Previous versions" />
                    <StackPanel Grid.Row="3" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Versions.IsAvailable}" Value="True" />
                                            <Condition Binding="{Binding Versions.HasLookedUp}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Image Source="/Assets/hound-dig.png" Width="200" Height="200" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="Which file do you want an older copy of?" Style="{StaticResource HeroTitle}" FontSize="22" HorizontalAlignment="Center" Margin="0,4,0,6" />
                        <TextBlock FontSize="13" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="520">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                    <Setter Property="Text" Value="Paste its path above. Every snapshot that still holds it is listed, newest first." />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Versions.HasSnapshots}" Value="False">
                                            <Setter Property="Text" Value="Windows creates snapshots when System Protection is on; FileHound never turns that on for you. Freeze this drive now makes one snapshot on demand." />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding Versions.IsEmpty, Converter={StaticResource VisibleWhen}}">
                        <Image Source="/Assets/hound-shrug.png" Width="200" Height="200" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="No snapshot holds this path" Style="{StaticResource HeroTitle}" FontSize="22" HorizontalAlignment="Center" Margin="0,4,0,6" />
                        <TextBlock Text="Check the spelling, or try the folder that contained it." Style="{StaticResource Caption}" FontSize="13" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Deep scan tab -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="DeepScan"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <c:ClayCard Background="{StaticResource Peach}" CornerRadius="20" Padding="18,14" Margin="2,2,2,8"
                                Visibility="{Binding DeepScan.IsAvailable, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource ClayButton}" Content="Enable Turbo" Command="{Binding EnableTurboCommand}" VerticalAlignment="Center"
                                    Visibility="{Binding IsElevated, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                            <Image Source="/Assets/icon-bolt.png" Width="48" Height="48" Margin="0,0,14,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Needs administrator access" Style="{StaticResource Title}" />
                                <TextBlock Style="{StaticResource Body}" Foreground="#7A4A36" TextWrapping="Wrap" Margin="0,4,16,0"
                                           Text="Deep scan reads the drive's free space directly, looking for file signatures. Enable Turbo (one administrator approval) to scan." />
                            </StackPanel>
                        </DockPanel>
                    </c:ClayCard>

                    <!-- FR-30 consent card -->
                    <c:ClayCard Grid.Row="1" Background="{StaticResource Sky}" CornerRadius="20" Padding="18,16" Margin="2,2,2,10" DataContext="{Binding DeepScan}"
                                Visibility="{Binding NeedsConsent, Converter={StaticResource VisibleWhen}}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <Button Style="{StaticResource SoftButton}" Content="Cancel" Command="{Binding DismissConsentCommand}" Margin="0,0,10,0" />
                                <Button Style="{StaticResource ClayButton}" Content="I understand, scan" Command="{Binding ConsentCommand}" />
                            </StackPanel>
                            <Image Source="/Assets/icon-shield.png" Width="48" Height="48" Margin="0,0,14,0" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Before the first deep scan" Style="{StaticResource Title}" />
                                <TextBlock Text="{Binding ConsentText}" Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </c:ClayCard>

                    <DockPanel Grid.Row="2" Margin="4,4,4,8" DataContext="{Binding DeepScan}" Visibility="{Binding IsAvailable, Converter={StaticResource VisibleWhen}}">
                        <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding SortChips}" Focusable="False" Margin="14,0,0,0">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="dsort2" Background="{Binding Dot}" Height="30" FontSize="12" Margin="6,0,0,0"
                                                 IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding Label}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource ClayButton}" Command="{Binding ScanCommand}" MinWidth="150" AutomationProperties.Name="Scan free space"
                                    Visibility="{Binding IsScanning, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Assets/icon-scan.png" Width="22" Height="22" Margin="-4,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock Text="Scan free space" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SoftButton}" Content="{Binding PauseResumeText}" Command="{Binding PauseResumeCommand}" MinWidth="90"
                                    Visibility="{Binding IsScanning, Converter={StaticResource VisibleWhen}}" />
                            <Button Style="{StaticResource SoftButton}" Content="Stop" Command="{Binding StopCommand}" Margin="8,0,0,0"
                                    Visibility="{Binding IsScanning, Converter={StaticResource VisibleWhen}}" />
                            <ItemsControl ItemsSource="{Binding TypeChips}" Focusable="False" Margin="14,0,0,0" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Style="{StaticResource Chip}" GroupName="dtype" Background="{Binding Dot}" Height="30" FontSize="12" Margin="0,0,6,0"
                                                     IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Fill="{Binding Dot}" Stroke="#30000000" StrokeThickness="0.5" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DockPanel>

                    <StackPanel Grid.Row="3" Margin="4,0,4,6" DataContext="{Binding DeepScan}" Visibility="{Binding IsAvailable, Converter={StaticResource VisibleWhen}}">
                        <DockPanel Margin="0,0,0,8" Visibility="{Binding IsScanning, Converter={StaticResource VisibleWhen}}">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" Style="{StaticResource Caption}" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" />
                            <ProgressBar Style="{StaticResource ClayProgress}" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Foreground="{StaticResource PeachDeep}" Height="8" VerticalAlignment="Center"
                                         AutomationProperties.Name="{Binding ProgressText}" />
                        </DockPanel>
                        <Border CornerRadius="12" Background="{StaticResource Rose}" Padding="12,8" Margin="0,0,0,8" Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Text="{Binding Error}" Foreground="{StaticResource GradeRoseInk}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="4" Visibility="{Binding DeepScan.IsAvailable, Converter={StaticResource VisibleWhen}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="12,4,22,6" TextElement.Foreground="{StaticResource InkFaint}" Visibility="{Binding DeepScan.Count, Converter={StaticResource VisibleWhen}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="2" Text="TYPE" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="3" Text="SIZE" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="4" Text="LOCATION" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </Grid>
                            <ListBox Grid.Row="1" ItemsSource="{Binding DeepScan.Items}" ItemTemplate="{StaticResource CarvedRow}" ItemContainerStyle="{StaticResource RecoveryRow}"
                                     SelectedItem="{Binding DeepScan.PreviewItem, Mode=TwoWay}"
                                     Background="Transparent" BorderThickness="0" SelectionMode="Extended"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                                     PreviewKeyDown="List_PreviewKeyDown" AutomationProperties.Name="Files found in free space" />
                            <StackPanel Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding DeepScan.HasScanned}" Value="False" />
                                                    <Condition Binding="{Binding DeepScan.IsScanning}" Value="False" />
                                                    <Condition Binding="{Binding DeepScan.NeedsConsent}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Image Source="/Assets/hound-dig.png" Width="200" Height="200" RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="Nothing scanned yet" Style="{StaticResource HeroTitle}" FontSize="22" HorizontalAlignment="Center" Margin="0,4,0,6" />
                                <TextBlock Text="Deep scan reads the drive's free space for file signatures. It takes a while on big drives." Style="{StaticResource Caption}" FontSize="13" HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding DeepScan.IsEmpty, Converter={StaticResource VisibleWhen}}">
                                <Image Source="/Assets/hound-shrug.png" Width="200" Height="200" RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="No recognisable files in free space" Style="{StaticResource HeroTitle}" FontSize="22" HorizontalAlignment="Center" Margin="0,4,0,6" />
                                <TextBlock Text="Either the space was reused, or the drive discarded it (SSD TRIM)." Style="{StaticResource Caption}" FontSize="13" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- preview pane -->
                        <c:ClayCard Grid.Column="1" Width="320" Margin="10,4,2,2" Padding="14" CornerRadius="20" Background="{StaticResource SurfaceSunken}" HasShadow="False"
                                    DataContext="{Binding DeepScan}" Visibility="{Binding Preview, Converter={StaticResource VisibleWhen}}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{Binding PreviewItem.TypeLabel}" Style="{StaticResource Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock DockPanel.Dock="Top" Text="{Binding Preview.Caption}" Style="{StaticResource Caption}" Margin="0,2,0,10" TextWrapping="Wrap" />
                                <Grid>
                                    <Border CornerRadius="14" ClipToBounds="True" Visibility="{Binding Preview.Image, Converter={StaticResource VisibleWhen}}">
                                        <Image Source="{Binding Preview.Image}" Stretch="Uniform" MaxHeight="360" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Preview.Text, Converter={StaticResource VisibleWhen}}">
                                        <TextBlock Text="{Binding Preview.Text}" FontSize="12" TextWrapping="Wrap" />
                                    </ScrollViewer>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Preview.Entries, Converter={StaticResource VisibleWhen}}">
                                        <ItemsControl ItemsSource="{Binding Preview.Entries}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate><TextBlock Text="{Binding}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,1" /></DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </DockPanel>
                        </c:ClayCard>
                    </Grid>
                </Grid>

                <!-- loading overlay -->
                <Border CornerRadius="20" Background="#80FFFBF5" IsHitTestVisible="False">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RecycleBin.IsLoading}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                <DataTrigger Binding="{Binding Deleted.IsLoading}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="/Assets/hound-sniff.png" Width="64" Height="64" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="Sniffing around…" Style="{StaticResource Title}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </c:ClayCard>

        <!-- ================================================= recovery footer -->
        <c:ClayCard Grid.Row="2" Background="{StaticResource Mint}" CornerRadius="24" Padding="18,12" Margin="0,14,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource ClayButton}" Content="{Binding RecoverButtonText}" Command="{Binding RecoverCommand}" IsEnabled="{Binding CanRecover}"
                            MinWidth="140" VerticalAlignment="Center" AutomationProperties.Name="{Binding RecoverButtonText}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Content="Save to a folder…" Command="{Binding SaveElsewhereCommand}" IsEnabled="{Binding CanSaveElsewhere}" Margin="0,0,10,0" VerticalAlignment="Center"
                            ToolTip="Copy the selected items to a folder of your choice instead of restoring in place"
                            Visibility="{Binding IsRestoreTab, Converter={StaticResource VisibleWhen}}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Open recovery folder" Command="{Binding OpenRecoveryFolderCommand}" Margin="0,0,16,0" VerticalAlignment="Center"
                            Visibility="{Binding RecoveryFolder, Converter={StaticResource VisibleWhen}}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedSummary}" Style="{StaticResource BodyStrong}" FontSize="13" Margin="0,0,16,0" VerticalAlignment="Center"
                               Visibility="{Binding SelectedSummary, Converter={StaticResource VisibleWhen}}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Undelete.EstimatedIntactText}" Style="{StaticResource Caption}" FontSize="12" Foreground="{StaticResource GradeMintInk}" Margin="0,0,16,0" VerticalAlignment="Center"
                               Visibility="{Binding Undelete.EstimatedIntactText, Converter={StaticResource VisibleWhen}}" />

                    <!-- Restore tabs: in place -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentTab}" Value="RecycleBin"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Image Source="/Assets/icon-recycle.png" Width="34" Height="34" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Restore puts items back in their original folder" Style="{StaticResource BodyStrong}" />
                            <TextBlock Text="If a file with the same name exists there, the restored copy gets “(restored)” added to its name." Style="{StaticResource Caption}" Foreground="{StaticResource GradeMintInk}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentTab}" Value="PreviousVersions"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Image Source="/Assets/icon-shadow.png" Width="34" Height="34" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Restore puts the older copy next to the current file" Style="{StaticResource BodyStrong}" />
                            <TextBlock Text="It is named “name (from date)” so nothing is overwritten." Style="{StaticResource Caption}" Foreground="{StaticResource GradeMintInk}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Recover tab: destination -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsRestoreTab, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                        <TextBlock Text="Save to" Style="{StaticResource BodyStrong}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Command="{Binding PickDestinationCommand}" Cursor="Hand" FocusVisualStyle="{StaticResource ClayFocusVisual}" AutomationProperties.Name="Choose destination folder">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Pill" CornerRadius="17" Height="36" MinWidth="260" Background="{StaticResource Surface}" Padding="14,0" Effect="{StaticResource ClayShadowSmall}">
                                        <DockPanel VerticalAlignment="Center">
                                            <TextBlock DockPanel.Dock="Right" Text="&#xE70D;" FontFamily="{StaticResource SymbolFont}" FontSize="11" Foreground="{StaticResource InkSoft}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                            <TextBlock x:Name="Label" Text="{Binding DestinationFolder, TargetNullValue=Choose a folder on another drive…}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" MaxWidth="420" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding DestinationError, Converter={StaticResource VisibleWhen}}" Value="Visible">
                                            <Setter TargetName="Pill" Property="Background" Value="{StaticResource Rose}" />
                                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource GradeRoseInk}" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Pill" Property="Background" Value="{StaticResource SidebarActive}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <TextBlock FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" MaxWidth="360" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                    <Setter Property="Foreground" Value="{StaticResource GradeMintInk}" />
                                    <Setter Property="Text" Value="A different drive is required, so nothing you recover can overwrite what you're recovering." />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DestinationError, Converter={StaticResource VisibleWhen}}" Value="Visible">
                                            <Setter Property="Text" Value="{Binding DestinationError}" />
                                            <Setter Property="Foreground" Value="{StaticResource GradeRoseInk}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>

                <!-- progress while recovering -->
                <DockPanel Grid.Row="1" Margin="0,10,0,0" Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" Style="{StaticResource Caption}" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" MaxWidth="420" TextTrimming="CharacterEllipsis" />
                    <ProgressBar Style="{StaticResource ClayProgress}" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Foreground="{StaticResource MintDeep}" Height="8" VerticalAlignment="Center"
                                 AutomationProperties.Name="{Binding ProgressText}" />
                </DockPanel>
            </Grid>
        </c:ClayCard>
    </Grid>
</UserControl>
