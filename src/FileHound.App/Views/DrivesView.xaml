<UserControl x:Class="FileHound.App.Views.DrivesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:FileHound.App.Controls">
    <UserControl.Resources>
        <c:VisibleWhenConverter x:Key="VisibleWhen" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="8,12,14,24">
            <c:ClayCard Background="{StaticResource Peach}" CornerRadius="26" Padding="20,16" Margin="0,0,0,22"
                        Visibility="{Binding IsElevated, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource ClayButton}" Content="Enable Turbo" Command="{Binding EnableTurboCommand}" VerticalAlignment="Center" />
                    <Image Source="/Assets/icon-bolt.png" Width="64" Height="64" Margin="0,0,16,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Standard indexing is on" Style="{StaticResource Title}" />
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource Body}" Foreground="#7A4A36" Margin="0,4,16,0"
                                   Text="FileHound is walking your folders, which is slower on big disks. Turbo reads each NTFS drive's master file table directly (millions of files in seconds) and keeps results live via the change journal. It needs one administrator approval." />
                    </StackPanel>
                </DockPanel>
            </c:ClayCard>

            <DockPanel Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Command="{Binding RescanAllCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource SymbolFont}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Rescan all" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock Text="Every ready fixed and removable drive is indexed automatically." Style="{StaticResource Caption}" FontSize="13" VerticalAlignment="Center" />
            </DockPanel>

            <ItemsControl ItemsSource="{Binding Drives}" Focusable="False" Margin="0,0,-16,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <c:ClayCard Margin="0,8,16,8" CornerRadius="24">
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" CornerRadius="11" Padding="10,3" Background="{Binding ModeBrush}" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding ModeText}" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                    <Image Source="/Assets/icon-drive.png" Width="56" Height="56" Margin="0,0,12,0" />
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Display}" FontSize="26" />
                                            <Border CornerRadius="9" Padding="7,1" Background="{StaticResource SurfaceSunken}" Margin="10,4,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Format}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InkSoft}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" FontSize="13" />
                                    </StackPanel>
                                </DockPanel>
                                <ProgressBar Style="{StaticResource ClayProgress}" Maximum="1" Value="{Binding UsedFraction, Mode=OneWay}" Foreground="{Binding UsedBrush}" Margin="0,16,0,6" />
                                <TextBlock Text="{Binding CapacityText}" Style="{StaticResource Caption}" />
                                <UniformGrid Columns="2" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="INDEXED" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource InkFaint}" />
                                        <TextBlock Text="{Binding EntriesText}" Style="{StaticResource BodyStrong}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="STATUS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource InkFaint}" />
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource BodyStrong}" />
                                    </StackPanel>
                                </UniformGrid>
                                <ProgressBar Style="{StaticResource ClayProgress}" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Foreground="{StaticResource ButterDeep}" Margin="0,10,0,0" Height="6"
                                             Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}" />
                                <TextBlock Text="{Binding Error}" Foreground="{StaticResource RoseDeep}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}" />
                                <DockPanel Margin="0,14,0,0">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Content="Rescan"
                                            Command="{Binding DataContext.RescanCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding LastIndexedText}" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding SkippedText}" Style="{StaticResource Caption}" Foreground="{StaticResource InkFaint}" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </c:ClayCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
