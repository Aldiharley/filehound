<UserControl x:Class="FileHound.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:FileHound.App.Controls">
    <UserControl.Resources>
        <c:VisibleWhenConverter x:Key="VisibleWhen" />
        <Style x:Key="Row" TargetType="CheckBox" BasedOn="{StaticResource ClaySwitch}">
            <Setter Property="Margin" Value="0,8" />
        </Style>
        <Style x:Key="Section" TargetType="c:ClayCard" BasedOn="{StaticResource {x:Type c:ClayCard}}">
            <Setter Property="Margin" Value="0,0,0,18" />
            <Setter Property="Padding" Value="24,18" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Grid Margin="8,12,14,24" MaxWidth="900" HorizontalAlignment="Left">
            <StackPanel>
                <c:ClayCard Style="{StaticResource Section}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Image Source="/Assets/icon-home.png" Width="32" Height="32" Margin="0,0,10,0" />
                            <TextBlock Text="General" Style="{StaticResource Title}" VerticalAlignment="Center" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource Row}" IsChecked="{Binding StartWithWindows}">
                            <StackPanel>
                                <TextBlock Text="Start with Windows" Style="{StaticResource BodyStrong}" />
                                <TextBlock Text="FileHound starts quietly in the tray so the hotkey is always ready." Style="{StaticResource Caption}" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource Row}" IsChecked="{Binding StartMinimized}">
                            <StackPanel>
                                <TextBlock Text="Start minimized to tray" Style="{StaticResource BodyStrong}" />
                                <TextBlock Text="Don't show the window at launch." Style="{StaticResource Caption}" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource Row}" IsChecked="{Binding CloseToTray}">
                            <StackPanel>
                                <TextBlock Text="Close button hides to tray" Style="{StaticResource BodyStrong}" />
                                <TextBlock Text="Keeps the index live in the background. Use the tray menu to exit." Style="{StaticResource Caption}" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </c:ClayCard>

                <c:ClayCard Style="{StaticResource Section}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Image Source="/Assets/icon-search.png" Width="32" Height="32" Margin="0,0,10,0" />
                            <TextBlock Text="Search" Style="{StaticResource Title}" VerticalAlignment="Center" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource Row}" IsChecked="{Binding Fuzzy}">
                            <StackPanel>
                                <TextBlock Text="Fuzzy matching" Style="{StaticResource BodyStrong}" />
                                <TextBlock Text="Find “quarterly_report.xlsx” from “qrtrly” or even “quartelry”." Style="{StaticResource Caption}" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource Row}" IsChecked="{Binding IncludeHidden}">
                            <StackPanel>
                                <TextBlock Text="Show hidden &amp; system files" Style="{StaticResource BodyStrong}" />
                                <TextBlock Text="Includes things like AppData and dot-folders." Style="{StaticResource Caption}" />
                            </StackPanel>
                        </CheckBox>
                        <Button Style="{StaticResource SoftButton}" Content="Clear recent searches" HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding ClearRecentCommand}" />
                    </StackPanel>
                </c:ClayCard>

                <c:ClayCard Style="{StaticResource Section}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Image Source="/Assets/icon-bolt.png" Width="32" Height="32" Margin="0,0,10,0" />
                            <TextBlock Text="Global hotkey" Style="{StaticResource Title}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Summon FileHound from anywhere. Click the box, then press your combination." Style="{StaticResource Caption}" FontSize="13" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="HotkeyBox" Command="{Binding BeginCaptureCommand}" Cursor="Hand" MinWidth="260" Height="44" PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                    AutomationProperties.Name="Global hotkey">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Border CornerRadius="14" Background="{StaticResource SurfaceSunken}" />
                                            <Border CornerRadius="14" Background="{StaticResource InsetShade}" />
                                            <Border x:Name="Ring" CornerRadius="14" BorderThickness="1.5" BorderBrush="Transparent" />
                                            <TextBlock Text="{Binding HotkeyText}" FontFamily="Cascadia Mono, Consolas" FontSize="15" FontWeight="SemiBold" Margin="16,0" VerticalAlignment="Center" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource PeachDeep}" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <TextBlock Text="{Binding HotkeyStatus}" Style="{StaticResource Caption}" FontSize="13" VerticalAlignment="Center" Margin="14,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </c:ClayCard>

                <c:ClayCard Style="{StaticResource Section}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Content="Add folder…" Command="{Binding AddExcludedCommand}" />
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Assets/icon-folder.png" Width="32" Height="32" Margin="0,0,10,0" />
                                <TextBlock Text="Excluded folders" Style="{StaticResource Title}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="FileHound skips these folders (and everything inside). Recycle bins and System Volume Information are always skipped."
                                   Style="{StaticResource Caption}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Excluded}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Background="{StaticResource SurfaceSunken}" Padding="12,6" Margin="0,3">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource RoundButton}" Width="28" Height="28" Content="&#xE711;" Foreground="{StaticResource RoseDeep}"
                                                    Command="{Binding DataContext.RemoveExcludedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                    ToolTip="Stop excluding" AutomationProperties.Name="Remove excluded folder" />
                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Changes apply on the next rescan (Drives → Rescan)." Foreground="{StaticResource PeachDeep}" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0"
                                   Visibility="{Binding ExcludesChanged, Converter={StaticResource VisibleWhen}}" />
                    </StackPanel>
                </c:ClayCard>

                <c:ClayCard Style="{StaticResource Section}" Background="{StaticResource Lilac}">
                    <DockPanel>
                        <Image DockPanel.Dock="Left" Source="/Assets/hound-avatar.png" Width="76" Height="76" Margin="0,0,16,0">
                            <Image.Clip>
                                <EllipseGeometry Center="38,38" RadiusX="38" RadiusY="38" />
                            </Image.Clip>
                        </Image>
                        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource SoftButton}" Content="Open logs folder" Command="{Binding OpenLogsCommand}" Margin="0,0,0,8" />
                            <Button Style="{StaticResource SoftButton}" Content="Open index folder" Command="{Binding OpenIndexFolderCommand}" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Version}" Style="{StaticResource Title}" />
                            <TextBlock Text="Fast, friendly file finding for every drive. Everything stays on this PC." Style="{StaticResource Caption}" FontSize="13" Foreground="{StaticResource Ink}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                </c:ClayCard>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
